# Server Configuration
PORT=3000

# Supabase Configuration
# IMPORTANT: Use the service_role key to allow the backend to bypass RLS policies and perform balance/inventory updates.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Cloudflare Workers AI Configuration
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token

# WhatsApp Business Cloud API Configuration
WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-number-id
WHATSAPP_ACCESS_TOKEN=your-whatsapp-access-token
WHATSAPP_VERIFY_TOKEN=your-whatsapp-verify-token

# Monnify Payment Configuration
# Multi-tenant: payments are routed to a PER-CLIENT sub-account (100% split),
# so each onboarded client needs its own settlement bank account. Sub-accounts
# API must be enabled for your Monnify platform account first (contact
# integration-support@monnify.com). With placeholder/empty values the app runs
# in mock payment mode (simulated links, no real charges).
MONNIFY_API_KEY=your-monnify-api-key
MONNIFY_SECRET_KEY=your-monnify-secret-key
MONNIFY_CONTRACT_CODE=your-monnify-contract-code
# Optional: force live base URL (default https://sandbox.monnify.com)
# MONNIFY_LIVE=1

# Monnify payment webhook: POST /api/payments/webhook
# Signatures are verified with HMAC-SHA512(rawBody) keyed by MONNIFY_SECRET_KEY
# (header `monnify-signature`). Set this URL in the Monnify dashboard. Note the
# signature header is only present in production; whitelist Monnify IP
# 35.242.133.146 upstream.
